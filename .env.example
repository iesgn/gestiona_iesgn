# Variables de entorno para docker-compose en producción
# Copia este fichero como .env en el servidor y rellena los valores reales
# El fichero .env NUNCA debe subirse al repositorio

VERSION_DEPLOY=
PORT_DEPLOY=
HEADSCALE_API_KEY=
SECRET_KEY=   # genera con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
